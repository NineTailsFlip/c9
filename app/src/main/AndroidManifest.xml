<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.WRITE_SYNC_SETTINGS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Event reminder notifications (calendar/reminders/). USE_EXACT_ALARM rather than
         SCHEDULE_EXACT_ALARM: it's granted at install, and reserved for exactly this kind of app
         (alarm clocks and calendars) - C9 only uses it to bring a snoozed reminder back on time. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <application
        android:name=".C9Application"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher_calendar"
        android:theme="@style/Theme.Nine"
        android:allowBackup="true">

        <!-- CalendarActivity and ContactsActivity each need their own explicit taskAffinity.
             Without it, both default to the package's own affinity (they're in the same APK per
             §2), so Android's launcher can resolve either home-screen icon to whichever task with
             that shared affinity already exists in Recents — confirmed on-device: tapping the
             Contacts icon after using Calendar could bring the existing Calendar task forward
             instead of Contacts' own, and vice versa. Sub-activities (EventEditActivity,
             ContactDetailActivity, ...) don't need their own — they're only ever started with a
             plain startActivity() from within their own already-running root activity, so they
             join whatever task that root activity is already in regardless of their own
             (inherited, package-default) taskAffinity value. -->
        <activity
            android:name=".calendar.CalendarActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity="life.furrer.c9.calendar"
            android:windowSoftInputMode="stateAlwaysHidden"
            android:configChanges="keyboardHidden|orientation|screenSize">
            <!-- Another app opening an event (content://com.android.calendar/events/<id>, typed
                 by the calendar provider) or a date (.../time/<millis>, typed time/epoch); read
                 by CalendarIntents, carried out once calendar permission is there. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.cursor.item/event" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:host="com.android.calendar" />
                <data android:mimeType="time/epoch" />
            </intent-filter>
        </activity>

        <!-- ContactsActivity/ContactDetailActivity are declared bare by :contacts' own manifest
             (life.furrer.nine.contacts) — the merger unions this declaration with that one, app
             attributes winning, which is what gives C9's contacts screen a launcher entry without
             P9 (which re-declares nothing) getting one too. -->
        <activity
            android:name="life.furrer.nine.contacts.ContactsActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity="life.furrer.c9.contacts"
            android:windowSoftInputMode="stateAlwaysHidden"
            android:configChanges="keyboardHidden|orientation|screenSize"
            tools:replace="android:exported">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.cursor.item/contact" />
            </intent-filter>
        </activity>

        <!-- The platform's "choose a contact" (ACTION_PICK on the contacts directory), answered by
             the picker's whole-contact mode, which returns the contact's lookup Uri. Declared here
             rather than on ContactsActivity (where it used to sit, never read): that screen
             restarts itself when search closes (restartFresh), which would drop the caller's
             pending result. Re-declared over :contacts' bare declaration, same as above. -->
        <activity
            android:name="life.furrer.nine.contacts.ContactValuePickerActivity"
            android:exported="true"
            tools:replace="android:exported">
            <intent-filter>
                <action android:name="android.intent.action.PICK" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.cursor.dir/contact" />
            </intent-filter>
        </activity>


        <activity
            android:name=".settings.CalendarSelectionActivity"
            android:exported="false"
            android:theme="@style/Theme.Nine" />

        <activity
            android:name=".calendar.EventDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.Nine" />

        <!-- Exported for other apps' "Add to calendar" (INSERT, prefilled from the
             CalendarContract extras) and "edit this event" (EDIT on an event Uri). These used to
             be declared on CalendarActivity, which never read them — the title and time were
             dropped and the plain calendar opened on today instead. Same fix as
             ContactEditActivity's below. INSERT/EDIT typed as a single event with no Uri (a
             widespread "add to calendar" snippet) is a new event too. -->
        <activity
            android:name=".calendar.EventEditActivity"
            android:exported="true"
            android:theme="@style/Theme.Nine">
            <intent-filter>
                <action android:name="android.intent.action.INSERT" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.cursor.item/event" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.INSERT" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.cursor.dir/event" />
            </intent-filter>
        </activity>

        <activity
            android:name=".calendar.EventSearchActivity"
            android:exported="false"
            android:windowSoftInputMode="stateAlwaysHidden"
            android:theme="@style/Theme.Nine" />

        <activity
            android:name="life.furrer.nine.contacts.ContactDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.Nine" />

        <!-- Exported for the platform's "save this number" hand-offs (P9's New contact / Add to
             existing contact): INSERT opens a new contact prefilled from Insert.PHONE/PHONE_TYPE,
             INSERT_OR_EDIT asks which contact and appends the number to it. These used to be
             declared on ContactsActivity, which never read them — the number was dropped and the
             plain contact list opened instead. -->
        <activity
            android:name=".contacts.ContactEditActivity"
            android:exported="true"
            android:theme="@style/Theme.Nine">
            <intent-filter>
                <action android:name="android.intent.action.INSERT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.cursor.dir/contact" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.INSERT_OR_EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.cursor.item/contact" />
            </intent-filter>
        </activity>

        <activity
            android:name=".contacts.FavoritesGroupActivity"
            android:exported="false"
            android:theme="@style/Theme.Nine" />

        <activity
            android:name=".contacts.GroupNameActivity"
            android:exported="false"
            android:theme="@style/Theme.Nine" />

        <activity
            android:name=".contacts.GroupChecklistActivity"
            android:exported="false"
            android:theme="@style/Theme.Nine" />

        <activity
            android:name=".contacts.GroupAddContactsActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <activity
            android:name=".contacts.ContactAccountsActivity"
            android:exported="false"
            android:theme="@style/Theme.Nine" />

        <activity
            android:name=".settings.SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.Nine" />

        <activity-alias
            android:name=".CalendarLauncher"
            android:targetActivity=".calendar.CalendarActivity"
            android:label="@string/app_name_calendar"
            android:icon="@mipmap/ic_launcher_calendar"
            android:roundIcon="@mipmap/ic_launcher_calendar"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".ContactsLauncher"
            android:targetActivity="life.furrer.nine.contacts.ContactsActivity"
            android:label="@string/app_name_contacts"
            android:icon="@mipmap/ic_launcher_contacts"
            android:roundIcon="@mipmap/ic_launcher_contacts"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Keeps starred contacts and the favorites group in step whenever the contacts DB
             changes (see FavoritesScheduler); BIND_JOB_SERVICE so only the system can run it. -->
        <service
            android:name=".contacts.FavoritesJobService"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false" />

        <!-- Content-trigger jobs don't survive a reboot; this re-arms it. -->
        <receiver
            android:name=".contacts.FavoritesBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- The calendar provider's reminder alarm: an implicit broadcast with
             FLAG_RECEIVER_INCLUDE_BACKGROUND and data content://com.android.calendar/<alarmTime>,
             so the filter needs the content scheme to match. Boot and app updates re-post the
             reminders still showing (notifications don't survive either). -->
        <receiver
            android:name=".calendar.reminders.EventReminderReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.EVENT_REMINDER" />
                <data android:scheme="content" />
                <data android:host="com.android.calendar" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- A reminder notification's Snooze/Dismiss, and the snooze alarm itself. -->
        <receiver
            android:name=".calendar.reminders.ReminderReceiver"
            android:exported="false" />

        <!-- Selecting a reminder notification: dismiss, then open the event in the calendar's
             task. No UI of its own; its empty affinity and excludeFromRecents keep the moment
             it exists from showing up anywhere. -->
        <activity
            android:name=".calendar.reminders.ReminderOpenActivity"
            android:exported="false"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

    </application>
</manifest>
